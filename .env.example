# YouTube Data API v3 — search.list, free tier. Powers Shorts/YouTube results.
YOUTUBE_API_KEY=

# Optional: Twitch Helix clips (skipped if unset).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
NEXT_PUBLIC_SITE_HOST=localhost

# Jarvis (NEWPI digest + tag suggestions). Defaults to the public VPS IP;
# on the VPS itself, point at localhost to skip the round trip.
JARVIS_API_URL=http://127.0.0.1:9999

# X is read through the public syndication CDN (see lib/twitter.ts) — no key.

# Flip Cam (/camera). Where saved shots + their edit metadata live on disk.
# On the VPS this is set by docker-compose.yml to a mounted volume so photos
# survive rebuilds; defaults to ./.data/photos for local dev. Ignored when
# BLOB_READ_WRITE_TOKEN is set (see below).
PHOTOS_DIR=

# Flip Cam on Vercel: a serverless function's disk is wiped between
# invocations, so PHOTOS_DIR alone never persists there. Connect a store in
# Vercel → Storage → Create Database → Blob and this is auto-injected —
# Flip Cam then saves to Blob storage instead of disk. Leave unset on the
# VPS (PHOTOS_DIR's volume is already persistent, no Blob store needed).
BLOB_READ_WRITE_TOKEN=
